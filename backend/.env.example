# Non-secret settings and placeholders only. Supply real secrets securely outside Git.
# Optional; a persistent local key is generated if this is absent.
# MAAK_SECRET_KEY=

# SQLite is the currently supported/tested database.
MAAK_DATABASE_URL=sqlite:///maak.db

# Set to 1 for HTTPS hosting; leave 0 for local HTTP development.
MAAK_COOKIE_SECURE=0
